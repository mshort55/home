#cloud-config
hostname: {{ unifi_vm_allocation.name }}
fqdn: {{ unifi_vm_allocation.name }}.{{ unifi_vm_allocation.domain }}
manage_etc_hosts: true
disable_root: true
ssh_pwauth: false
users:
  - name: {{ unifi_vm_allocation.username }}
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
{% for path in unifi_vm_allocation.ssh_public_key_files %}
      - {{ lookup('ansible.builtin.file', path) | trim | to_json }}
{% endfor %}
ssh_keys:
  ed25519_private: |
{{ lookup('ansible.builtin.file', unifi_seed_directory ~ '/ssh_host_ed25519_key') | indent(4, true) }}
  ed25519_public: {{ lookup('ansible.builtin.file', unifi_seed_directory ~ '/ssh_host_ed25519_key.pub') | trim | to_json }}
# The pinned Ubuntu image already includes Python and nftables. Install the guard
# before package downloads; it is active before the controller is installed.
bootcmd:
  - - cloud-init-per
    - once
    - home-unifi-isolation
    - /usr/bin/python3
    - -c
    - |
      import base64, os, pathlib, socket, subprocess
      socket.sethostname({{ unifi_vm_allocation.name | to_json }}.encode())
      # Prevent the distribution's global-flush unit from replacing the owned table.
      subprocess.run(['systemctl', 'mask', 'nftables.service'], check=True)
      pathlib.Path('/etc/home-automation').mkdir(mode=0o700, parents=True, exist_ok=True)
      for filename, encoded, mode in [('/etc/home-automation/unifi-policy.nft.json', {{ unifi_bootstrap_policy.stdout | b64encode | to_json }}, 0o600), ('/etc/home-automation/unifi-isolation.json', {{ lookup('ansible.builtin.template', 'isolation.json.j2') | b64encode | to_json }}, 0o600)]:
          path = pathlib.Path(filename)
          path.write_bytes(base64.b64decode(encoded))
          os.chmod(path, mode)
      subprocess.run(['/usr/sbin/nft', '--check', '-j', '-f', '/etc/home-automation/unifi-policy.nft.json'], check=True)
      subprocess.run(['/usr/sbin/nft', '-j', '-f', '/etc/home-automation/unifi-policy.nft.json'], check=True)
package_update: true
packages: [python3, openssh-server, nftables, qemu-guest-agent, ca-certificates, podman, slirp4netns, passt, systemd-timesyncd]
write_files:
  - path: /etc/ssh/sshd_config.d/00-home-automation.conf
    permissions: '0600'
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      AllowUsers {{ unifi_vm_allocation.username }}
  - path: /etc/sysctl.d/90-home-automation.conf
    content: |
      net.ipv6.conf.all.disable_ipv6=1
      net.ipv6.conf.default.disable_ipv6=1
  - path: /etc/systemd/timesyncd.conf.d/90-home-automation.conf
    content: |
      [Time]
      NTP={{ unifi_vm_allocation.gateway }}
      FallbackNTP=
  - path: /etc/systemd/system/home-unifi-isolation.service
    permissions: '0644'
    encoding: b64
    content: {{ lookup('ansible.builtin.template', role_path ~ '/../unifi_firewall/templates/isolation.service.j2') | b64encode | to_json }}
  - path: /etc/systemd/system/uosserver.service.d/10-home-isolation.conf
    permissions: '0644'
    encoding: b64
    content: {{ lookup('ansible.builtin.template', role_path ~ '/../unifi_firewall/templates/guard.conf.j2') | b64encode | to_json }}
  - path: /etc/systemd/system/uosserver-updater.service.d/10-home-isolation.conf
    permissions: '0644'
    encoding: b64
    content: {{ lookup('ansible.builtin.template', role_path ~ '/../unifi_firewall/templates/guard.conf.j2') | b64encode | to_json }}
runcmd:
  - [sysctl, --system]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, home-unifi-isolation.service]
  - [systemctl, enable, --now, qemu-guest-agent]
  - [systemctl, restart, ssh]
  - [systemctl, restart, systemd-timesyncd]
  - [sh, -c, '/usr/sbin/nft --check -j -f /etc/home-automation/unifi-policy.nft.json && /usr/sbin/nft -j -f /etc/home-automation/unifi-policy.nft.json && touch /var/lib/cloud/home-automation-ready']
