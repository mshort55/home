# Managed by configure-proxmox-bridges.yml.
# Management and physical interface stanzas remain in /etc/network/interfaces.
{% for bridge in proxmox_network.guest_bridges %}

auto {{ bridge.name }}
iface {{ bridge.name }} inet manual
    disable-ipv6 yes
    bridge-ports {{ bridge.port }}
    bridge-stp off
    bridge-fd 0
{% if bridge.vlan_aware %}
    bridge-vlan-aware yes
    bridge-vids {{ bridge.vlans | sort | join(' ') }}
{% endif %}
{% endfor %}
