---
offline: true
profile: safety
strict: true
# Safety does not include every correctness rule. Enable these explicitly while
# keeping collection-publishing requirements out of this private repository.
enable_list:
  - fqcn
  - ignore-errors
  - no-changed-when
  - no-log-password
  - no-same-owner
# The experimental args rule falsely reports inherited group module_defaults
# as missing arguments. Keep syntax/schema and role-contract validation active.
# Roles intentionally keep established host-scoped workflow outputs and use
# role: action play names. Key ordering does not change their block semantics.
# Retain other naming checks; the two formatting exceptions avoid broad churn.
skip_list:
  - var-naming[no-role-prefix]
  - name[casing]
  - key-order[task]
exclude_paths:
  - .cache/
  - .collections/
  - .venv/
  - .venv-mac/
  - .venv-macos/
  - .venv-validation/
  - .venv-validation-macos/
  - backups/
  - secrets/
  - inventory.private.yml
  - tests/
extra_vars:
  vault_file: "{{ lookup('ansible.builtin.env', 'HOME_VALIDATION_VAULT') }}"
